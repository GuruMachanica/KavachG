{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/console", "destination": "/console.html" },
    { "source": "/modules", "destination": "/modules.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/architecture", "destination": "/architecture.html" },
    { "source": "/compliance", "destination": "/compliance.html" },
    { "source": "/benchmarks", "destination": "/benchmarks.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *;" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
